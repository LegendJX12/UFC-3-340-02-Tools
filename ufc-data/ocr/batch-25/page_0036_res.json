                291
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Equivalent elastic deflection from Equation 3-36 is:",
            "block_bbox": [
                275,
                266,
                804,
                290
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "formula",
            "block_content": "X_{E}=\\frac{r_{u}}{K_{E}}=\\frac{1.236.79}{8.629.70}=0.1433\\ln ",
            "block_bbox": [
                349,
                311,
                685,
                368
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Step 10.",
            "block_bbox": [
                136,
                392,
                224,
                416
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Load-mass factor from Table 3-12 (+) for a plastic range of a uniformly loaded beam with fixed ends is:",
            "block_bbox": [
                273,
                392,
                1005,
                441
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&K_{LM}&\\text{-elastic}&=0.77\\\\&&\\text{-elastic-phase}&=0.78\\\\&&\\text{-plastic}&=0.66\\\\ \\end{aligned}",
            "block_bbox": [
                344,
                462,
                683,
                564
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "$K_{L M}$ for plastic mode deflections; from Section 3-17.4 from Chapter 3:",
            "block_bbox": [
                275,
                596,
                990,
                620
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "K_{LM}=\\left[\\left[\\frac{0.77+0.78}{2}\\right]+0.66\\right]/2=0.72",
            "block_bbox": [
                347,
                641,
                745,
                710
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Step 11.Natural period of the beam from Equation 3-60 is:",
            "block_bbox": [
                134,
                732,
                792,
                756
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "T_{N}=2\\pi(K_{L M}m/K_{E})^{1/2}",
            "block_bbox": [
                346,
                773,
                569,
                802
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Where m is the mass of the beam plus 20% of the slabs span perpendicular to the beam:",
            "block_bbox": [
                274,
                822,
                913,
                873
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}m&=\\frac{W}{g}\\\\&=\\left(30\\times18+2\\times8\\times102\\times0.20\\right)\\times\\frac{150}{12^3}\\times\\frac{1000^2}{32.2\\times12^3}\\\\&=194,638.50\\;lbs-m^2/i n^2\\\\T_n&=2\\pi\\left[\\frac{0.72\\times194,638.50}{8,629.70}\\right]^{1/2}=25.3\\;ms\\end{aligned}",
            "block_bbox": [
                349,
                900,
                863,
                1135
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "Step 12.Find $\\mu,$ ductility ratio from Figure 3-54 (+)",
            "block_bbox": [
                134,
                1159,
                709,
                1185
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "From Step 1:",
            "block_bbox": [
                275,
                1204,
                416,
                1226
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\mathsf{T}/\\mathsf{T}_{\\mathsf{N}}&=60.7/25.3=2.40\\\\\\mathsf{P}&=(18+84+120)\\times7.2\\\\&=1,598.40\\mathsf{Ibs}/\\mathsf{in}\\\\r_{u}/\\mathsf{P}&=\\frac{1,236.79}{1,598.40}=0.77\\\\\\mu&=9.0\\end{aligned}",
            "block_bbox": [
                349,
                1248,
                634,
                1442
            ],
            "block_id": 15,
            "block_order": 15
        },
