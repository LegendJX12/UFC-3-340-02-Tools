    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "From Section 4-33.5 for Type IIl cross sections and valid for deflection range:",
            "block_bbox": [
                345,
                266,
                966,
                315
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}0\\leq X_{m}\\leq X_{1}\\\\\\frac{{i_{b}}^{2}H}{{p_{H}d_{c}}^{3}f_{ds}}=C_{1}\\left(\\frac{X_{m}}{X_{1}}\\right)\\\\X_{m}=\\frac{{i_{b}}^{2}HX_{1}}{{p_{H}d_{c}}^{3}f_{ds}C_{1}}\\\\=\\frac{(3200)^{2}(120)(25.5)}{(0.00343)(20.87)^{3}(87,840)452.0}\\\\=25.3in\\end{aligned}",
            "block_bbox": [
                344,
                336,
                797,
                630
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Note: The element is slightly over-designed. To obtain a more economical design, the amount of flexural reinforcement may be reduced.",
            "block_bbox": [
                274,
                656,
                1041,
                706
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Step 16.",
            "block_bbox": [
                136,
                725,
                224,
                750
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "The response time of the element is obtained from:",
            "block_bbox": [
                275,
                726,
                807,
                749
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\pmb{t}_{m}=\\frac{\\dot{I}_{b}}{r_{u}}",
            "block_bbox": [
                349,
                774,
                424,
                830
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "where:",
            "block_bbox": [
                275,
                855,
                350,
                874
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}=\\frac{5(M_{H N}+M_{H P})}{x^{2}}",
            "block_bbox": [
                348,
                896,
                538,
                951
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "but:",
            "block_bbox": [
                275,
                975,
                318,
                994
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}M_{_{HN}}&=M_{_{HP}}=\\frac{A_{_{sh}}f_{_{ds}}d_{_c}}{b}\\\\&=\\frac{0.86(87,840)(20.87)}{12}\\\\&=131.380in-lbs/in\\end{aligned}",
            "block_bbox": [
                348,
                1019,
                629,
                1168
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "therefore:",
            "block_bbox": [
                275,
                1195,
                380,
                1215
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}=\\frac{5(2)(131,380)}{(129)^{2}}=78.9\\mathrm{ps}i ",
            "block_bbox": [
                348,
                1236,
                640,
                1298
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "so that:",
            "block_bbox": [
                275,
                1323,
                356,
                1342
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&t_{m}=\\frac{i_{b}}{r_{u}}=\\frac{3200}{78.9}=40.6ms\\\\ &\\frac{t_{m}}{t_{o}}=\\frac{40.6}{5}=8.12\\\\ \\end{aligned}",
            "block_bbox": [
                346,
                1367,
                616,
                1494
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "formula_number",
            "block_content": "(Equation 3-96)",
            "block_bbox": [
                887,
                785,
                1049,
                811
            ],
            "block_id": 15,
            "block_order": null
        },
        {
            "block_label": "formula_number",
            "block_content": "(Table 3-2 (+))",
            "block_bbox": [
                899,
                912,
                1048,
                938
            ],
            "block_id": 16,
            "block_order": null
        },
        {
            "block_label": "number",
            "block_content": "4A-47",
            "block_bbox": [
                567,
                1517,
                630,
                1537
            ],
            "block_id": 17,
            "block_order": null
        }
    ],
