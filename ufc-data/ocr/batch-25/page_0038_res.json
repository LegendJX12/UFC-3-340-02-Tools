                134,
                559,
                746,
                583
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&A_{v}=\\left[\\left(v_{u}-v_{c}\\right)\\times b\\times s_{s}\\right]/\\phi\\times f_{dy};\\quad v_{u}-v_{c}\\geq v_{c}\\\\&v_{u}-v_{c}=235.2-131.4=104<v_{c}\\quad\\mathrm{use}\\quad v_{c}\\\\ \\end{aligned}",
            "block_bbox": [
                343,
                606,
                791,
                672
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Assume:",
            "block_bbox": [
                275,
                696,
                372,
                715
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&s_{s}=9in\\\\&A_{v}=131.4\\times18\\times9/(0.85\\times66,000)\\\\&\\quad=0.38in/9in^2\\\\ \\end{aligned}",
