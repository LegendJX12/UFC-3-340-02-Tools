                266,
                878,
                290
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\boldsymbol{v}_{c}&=\\left[1.9\\left(\\boldsymbol{f}_{dc}^{\\prime}\\right)^{1/2}+2.500\\boldsymbol{p}\\right]\\\\<&3.5\\left(\\boldsymbol{f}_{dc}^{\\prime}\\right)^{1/2}\\\\\\boldsymbol{v}_{c}&=\\left[1.9\\left(4.000\\right)^{1/2}+2.500\\times0.0045\\right]\\\\=&131.4\\mathrm{~psi}\\\\(3.5\\left(\\boldsymbol{f}_{dc}^{\\prime}\\right)^{1/2}&=3.5\\times\\left(4.000\\right)^{1/2}\\\\=&221.4\\mathrm{~psi}>131.4\\mathrm{~psi}\\quad\\mathrm{O.K.}\\end{aligned}",
            "block_bbox": [
                346,
                305,
                800,
                534
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Step 17.Area of web reinforcing from Equation 4-141:",
