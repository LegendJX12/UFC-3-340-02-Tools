    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2, 1 September 2014",
            "block_bbox": [
                730,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "The correct procedure has been used since:",
            "block_bbox": [
                276,
                267,
                737,
                289
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{t_{m}}{t_{o}}>3",
            "block_bbox": [
                349,
                313,
                420,
                369
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Step 17.Ultimate support shear.",
            "block_bbox": [
                134,
                392,
                521,
                416
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "a.Vertical Direction (along L):",
            "block_bbox": [
                274,
                436,
                632,
                460
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&\\mathsf{From\\ Figure\\ 4-54\\ (+),\\ for:}\\\\ &\\quad x/L=0.385\\\\ &\\quad C_{sV}=4.40\\\\ &\\quad v_{sV}=\\frac{C_{sv}p_{v}d_{c}^{2}f_{ds}}{H}\\quad(eq.\\ 4-122)\\\\ &\\quad=\\frac{4.40(1.20)(20.87)^{2}(87.840)}{12(20.87)(120)}\\\\ &\\quad=6720\\ \\mathsf{lbs/in}\\\\ \\end{aligned}",
            "block_bbox": [
                343,
                480,
                784,
                778
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "b.Horizontal Direction (along H):",
            "block_bbox": [
                274,
                802,
                663,
                826
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "From Table 4-15 (+):",
            "block_bbox": [
                344,
                846,
                565,
                870
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}C_{sH}=\\frac{6}{x/L}=\\frac{6}{0.385}=15.6\\\\v_{sH}=\\frac{C_{sH}p_H d_c^{2}f_{ds}}{L}\\quad(eq.4-121)\\\\=\\frac{15.6(0.00343)(20.87)^2(87.840)}{336}\\\\=6.090\\quad|bs/in\\end{aligned}",
            "block_bbox": [
                347,
                892,
                788,
                1113
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Step 18.Diagonal bar sizes.",
            "block_bbox": [
                134,
                1140,
                479,
                1164
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "Note: Place bars on a $45^{\\circ}$ angle.",
            "block_bbox": [
                274,
                1184,
                615,
                1208
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Therefore, sin $\\alpha=0.707$ ",
            "block_bbox": [
                275,
                1231,
                539,
                1253
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "a.Vertical Direction (at floor slab):",
            "block_bbox": [
                274,
                1276,
                677,
                1299
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "formula",
            "block_content": "A_{d}=\\frac{V_{sv}b}{f_{ds}\\sin\\alpha}=\\frac{6.720(10)}{81.300(0.707)}=1.17\\ln^{2}",
            "block_bbox": [
                347,
                1318,
                759,
                1378
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "Required area of bar:",
            "block_bbox": [
                344,
                1402,
                571,
                1424
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{A_{d}}{2}=0.58\\ln^{2}",
            "block_bbox": [
                347,
                1447,
                492,
                1499
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "formula_number",
            "block_content": "(Equation 4-30)",
            "block_bbox": [
                888,
                1333,
                1049,
                1359
            ],
            "block_id": 16,
            "block_order": null
        },
