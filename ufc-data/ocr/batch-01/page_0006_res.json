    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 208Change 2,1 September 2014",
            "block_bbox": [
                731,
                141,
                1050,
                220
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Reasons for Changes:",
            "block_bbox": [
                135,
                222,
                386,
                245
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "To correct errors and inconsistencies and to add clarifications ",
            "block_bbox": [
                204,
                278,
                881,
                299
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "To clarify applications and limitations of this document in satisfying DoD 6055.09-M requirements \n",
            "block_bbox": [
                204,
                305,
                983,
                354
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "To update sections based on current state-of-the-knowledge and recent testing \n",
            "block_bbox": [
                204,
                362,
                985,
                409
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "To improve document usability and change the document format to simplify implementation of future changes \n",
            "block_bbox": [
                204,
                417,
                1020,
                466
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "Impact: There are no anticipated cost impacts. However, the following benefits should be realized.\n",
            "block_bbox": [
                133,
                550,
                1042,
                599
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "The document has a more user-friendly format including the ability to simultaneously view figures and tables with the discussion in the text ",
            "block_bbox": [
                204,
                633,
                957,
                682
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "The new masonry design procedures are based on current construction practice and allow the more cost effective use of blast resistant masonry walls ",
            "block_bbox": [
                205,
                690,
                1047,
                739
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "The new mechanical splice requirements will, for the first time, allow mechanical couplers to be used in blast resistant construction, significantly reducing reinforcing bar congestion and simplifying concrete placement ",
            "block_bbox": [
                204,
                744,
                1016,
                821
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "The changes to the document's format will simplify implementation of future changes \n",
            "block_bbox": [
                204,
                826,
                1024,
                877
            ],
            "block_id": 10,
            "block_order": 10
        }
    ],
