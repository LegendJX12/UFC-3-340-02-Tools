            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "b.Find shear area for out-of-plane shear (Equation 6-4a). The percentage of grout-filled voids Vis zero.",
            "block_bbox": [
                274,
                494,
                969,
                547
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}A_{no}=\\left(A_{fs}+(1-A_{fs})\\frac{V}{100}\\right)T\\\\=\\left(0.47+(1-0.47)\\frac{0}{100}\\right)(7.63)\\\\=3.6\\ln^2/\\ln\\end{aligned}",
            "block_bbox": [
                348,
                569,
                703,
                735
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "C.Calculate the out-of-plane shear strength (Equation 6-3)",
