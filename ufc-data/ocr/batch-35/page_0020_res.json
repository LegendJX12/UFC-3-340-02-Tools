        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}V_{u o}&=r_{u}\\left(\\frac{L}{2}-T\\right)\\\\&=0.82\\left(\\frac{120}{2}-7.63\\right)\\\\&=43\\mathrm{~lb}/\\mathrm{in}\\end{aligned}",
