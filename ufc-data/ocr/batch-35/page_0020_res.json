        },
        {
            "block_label": "paragraph_title",
            "block_content": "Step 18.Design connections ",
            "block_bbox": [
                134,
                978,
                485,
                1003
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "a.Calculate the connection design load, which is equal to the ultimate shear force at the support. This will be used for the inbound and rebound design connection load. The calculated maximum resistance in rebound from the time-stepping SDOF analysis is less than $\\mathsf{r}_{\\mathsf{u}}$ . However, a lesser blast load could cause a maximum inbound deflection less than $\\mathsf{X_{e}}$ and the maximum rebound resistance could be nearly equal to $\\mathsf{r}_{\\mathsf{u}}$ in this case.",
            "block_bbox": [
                274,
                1025,
                1044,
                1208
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}V_{u}=&\\frac{r_{u}L}{2}\\\\ =&\\frac{0.82(120)}{2}=49lb/in\\end{aligned}",
