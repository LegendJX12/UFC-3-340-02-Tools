                274,
                758,
                928,
                783
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&V_{mo}=2\\sqrt{f_m^{'}}A_n\\\\&\\quad=2\\sqrt{1300}(3.6)\\\\&\\quad=260Ib/j\\eta>43Ib/j\\eta\\\\ \\end{aligned}",
            "block_bbox": [
                347,
