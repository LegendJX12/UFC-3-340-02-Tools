            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "e.Shear reinforcement ",
            "block_bbox": [
                275,
                444,
                564,
                465
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Assume #3 closed ties ",
            "block_bbox": [
                344,
                488,
                585,
                509
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}A_{v}&=2\\times0.11=0.22\\ln^{2}\\\\s_{s}&=\\frac{A_{v}\\Phi f_{y}}{v_{c}b}=\\frac{0.22\\times0.85\\times66,000}{142\\times4.75}\\\\&=18.3\\ln\\end{aligned}",
            "block_bbox": [
                343,
                531,
                700,
                666
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&if.\\quad&&\\textsf{Check maximum spacing and minimum required reinforcement}\\\\&&&s\\;\\leq\\;d_p/2=22.0/2=11.0\\;in\\\\&&&\\textsf{A}_v\\leq\\;0.0015bs_s\\\\&&&\\quad=0.0015\\times4.75\\times11.0\\quad=0.08\\;in^2\\;>0.22\\;in^2\\end{aligned}",
            "block_bbox": [
                273,
                702,
                999,
                863
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Shear reinforcement is thus #3 ties at 11 inches in both stems.",
            "block_bbox": [
                344,
                882,
                992,
                904
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Step 20.Check direct shear.",
