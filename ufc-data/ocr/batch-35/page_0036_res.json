        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&v_{u}-v_{c}\\leq v_{c}\\\\&v_{u}-v_{c}=127-142=-15\\mathrm{psi}\\\\ \\end{aligned}",
            "block_bbox": [
                345,
