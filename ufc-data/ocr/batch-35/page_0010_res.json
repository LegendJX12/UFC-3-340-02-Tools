        },
        {
            "block_label": "text",
            "block_content": "Step 14.Check out-of-plane shear strength of wall.",
            "block_bbox": [
                134,
                266,
                711,
                290
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "a.Calculate ultimate shear force (out-of-plane) at distance d from support.\n",
            "block_bbox": [
                274,
                310,
                997,
                361
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}V_{u o}&=r_{u}\\left(\\frac{L}{2}-d\\right)\\\\&=1.23\\left(\\frac{150}{2}-3.81\\right)\\\\&=87.5\\mathrm{~lb}/\\mathrm{in}\\end{aligned}",
            "block_bbox": [
                347,
                383,
                583,
                548
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "b.Find shear area for out-of-plane shear (Equation 6-4a)",
            "block_bbox": [
                280,
                575,
                918,
                599
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}A_{no}=\\left(A_{rs}+(1-A_{rs})\\frac{V}{100}\\right)d\\\\=\\left(0.47+(1-0.47)\\frac{50}{100}\\right)(3.81)\\\\=2.8\\mathrm{in}^2/\\mathrm{in}\\end{aligned}",
            "block_bbox": [
                348,
                622,
                701,
                789
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "C.Compute out-of-plane shear strength (Equation 6-3)",
            "block_bbox": [
                280,
                812,
                892,
                836
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&V_{mo}=2\\sqrt{f_m^{'}A_n}\\\\ &\\quad=2\\sqrt{2000}(2.8)\\\\ &\\quad=250lb/in>87.5lb/in\\\\ \\end{aligned}",
            "block_bbox": [
                347,
                856,
                652,
                962
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "The shear strength exceeds the shear force – OK ",
            "block_bbox": [
                345,
                989,
                862,
                1011
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Step 15.Design connections ",
            "block_bbox": [
                134,
                1032,
                486,
                1056
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "a.Find maximum rebound resistance ",
            "block_bbox": [
                274,
                1078,
                709,
                1099
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}{T/T_{N}=1.25}\\\\ {X_{m}/X_{E}=9.0}\\end{aligned}",
            "block_bbox": [
                345,
                1121,
                475,
                1189
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "From Figure 3-268 (+)",
            "block_bbox": [
                344,
                1210,
                580,
                1233
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "formula",
            "block_content": "r^{-}/r_{u}=0.98",
            "block_bbox": [
                347,
                1255,
                482,
                1283
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "formula",
            "block_content": "r^{-}=0.98\\times1.23=1.21\\mathrm{ps}",
            "block_bbox": [
