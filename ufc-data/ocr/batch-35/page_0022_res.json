        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&V_{mi}=2\\sqrt{f_{m}^{'}}A_{ni}\\\\&\\quad=2\\sqrt{1300}(2.0)\\\\&\\quad=144Ib/j\\eta\\\\ \\end{aligned}",
            "block_bbox": [
