    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&new I_{g}=25180in^{4}\\\\&c.\\quad&w=497×150pcf/12^{3}=43.1lb/in\\\\&d.\\quad&d_{p}=7.85+14.15=22.0in\\\\&e.\\quad&A_{ps}=4×0.153=0.612in^{2}\\end{aligned}",
            "block_bbox": [
                274,
                261,
                705,
                428
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "f.Prestressed reinforcement ratio (Equation 6-17)",
            "block_bbox": [
                274,
                447,
                845,
                471
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "formula",
            "block_content": "p_{p}=A_{ps}/bd_{p}=0.612/(96\\times22.0)=0.000290",
            "block_bbox": [
                343,
                493,
                800,
                517
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Step 6.",
            "block_bbox": [
                136,
                536,
                212,
                562
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Determine the average stress in the prestressing tendon.",
            "block_bbox": [
                275,
                538,
                866,
                561
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&a.\\quad&f_{\\rho y}/f_{\\rho u}=0.85\\quad so\\quad\\gamma_{\\rho}=0.40\\\\&b.\\quad&\\beta_{1}=0.85-0.05(5950-4000)/1000=0.7525\\\\ \\end{aligned}",
            "block_bbox": [
                275,
                582,
                797,
                653
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "C.Average stress (Equation 6-21)",
            "block_bbox": [
                275,
                673,
                676,
                697
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\boldsymbol{f}_{ps}&=\\boldsymbol{f}_{pu}\\left[1-\\frac{\\gamma_{p}\\rho_{p}\\boldsymbol{f}_{pu}}{\\beta_{1}\\boldsymbol{f}_{dc}}\\right]\\\\&=270,000\\left[1-\\frac{0.40\\times0.000290\\times270,000}{0.7525\\times5950}\\right]\\\\&=268,111\\mathrm{ps}i\\\\ \\end{aligned}",
            "block_bbox": [
                277,
                717,
                730,
                889
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Step 7.Check maximum reinforcement ratio (Equation 6-24).",
            "block_bbox": [
                136,
                913,
                829,
                938
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&\\rho_{p}f_{ps}/f_{dc}^{\\prime}\\leq0.36\\ \\beta_{1}\\\\&\\rho_{p}f_{ps}/f_{dc}^{\\prime}=0.000290\\times268,111/5950=0.0131\\\\&0.36\\ \\beta_{1}=0.36\\times0.7525=0.2709>0.0131\\quad O.K.\\\\ \\end{aligned}",
            "block_bbox": [
                274,
                955,
                798,
                1074
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Step 8.Calculate moment capacity of beam.",
            "block_bbox": [
                135,
                1094,
                659,
                1118
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "From Equation 6-15",
            "block_bbox": [
                275,
                1138,
                488,
                1160
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "formula",
            "block_content": "a=\\frac{A_{ps}f_{ps}}{0.85f_{dc}^{'}b}=\\frac{0.612\\times268,111}{0.85\\times5950\\times96}=0.34in ",
            "block_bbox": [
                277,
                1185,
                700,
                1248
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "$c=a/\\beta_{1}=0.34/0.7525=0.45<3.0$ inch thick flange ",
            "block_bbox": [
                275,
                1272,
                817,
                1296
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "text",
            "block_content": "Hence the neutral axis is within the flange and the section can be analyzed as a rectangular section. If the neutral axis had extended into the web, a strain compatibility analysis would be required.",
            "block_bbox": [
                274,
                1317,
                1048,
                1395
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "footer",
            "block_content": "6A-29",
            "block_bbox": [
                567,
                1518,
                630,
                1537
            ],
            "block_id": 16,
            "block_order": null
        }
    ],
