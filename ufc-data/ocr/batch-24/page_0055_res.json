        },
        {
            "block_label": "formula",
            "block_content": "\\left(A_{s}\\right)_{m9}=\\frac{m_{9}^{+}}{m_{5}^{+}}\\times\\left(A_{s}\\right)_{m5}=\\frac{0.348\\frac{M_{OH}}{240}}{0.256\\frac{M_{OH}}{240}}\\times0.20=0.27\\ln^{2}/\\mathrm{ft}",
