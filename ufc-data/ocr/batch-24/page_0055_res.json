        },
        {
            "block_label": "text",
            "block_content": "Calculate the average unit tension force in continuous steel.",
            "block_bbox": [
                274,
                474,
                897,
                496
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}T_{L}=\\frac{\\left(A_{s}\\right)_{m5}H/2+\\left(A_{s}\\right)_{m9}(L-H/2)}{b\\times L}\\times f_{ds}\\times2\\\\=\\frac{0.20\\times240/2+0.27\\times(240-240/2)}{12\\times240}\\times85,860\\times2=3.362\\text{lbs/in}\\end{aligned}",
            "block_bbox": [
                347,
