            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}r_{T}=&\\frac{\\pi^{3}\\times1.5\\times\\boldsymbol{X}\\times\\boldsymbol{T}_{H}/\\boldsymbol{L}_{H}^{2}}{4\\sum_{n=1,3,5}\\left[\\frac{1}{n^{3}}(-1)^{(n-1)/2}\\left[1-\\frac{1}{cosh\\left[\\frac{n\\pi\\boldsymbol{L}_{L}}{2\\boldsymbol{L}_{H}}\\left[\\frac{\\boldsymbol{T}_{H}}{\\boldsymbol{T}_{L}}\\right]^{1/2}\\right]}\\right]\\right]}\\\\H_{L}=&\\boldsymbol{H}-\\boldsymbol{C}=240-40=200i n\\\\r_{T}=&\\frac{\\pi^{3}\\times1.5\\times14.05\\times3.363/200^{2}}{4\\sum_{n=1,3,5}\\left[\\frac{1}{n^{3}}(-1)^{(n-1)/2}\\left[1-\\frac{1}{cosh\\left[\\frac{n\\pi(20)}{2(200)}\\left[\\frac{3.363}{3.363}\\right]^{1/2}\\right]}\\right]\\right]}\\\\r_{T}=&\\frac{\\pi^{3}\\times1.5\\times14.05\\times3.363}{4\\times(200)^{2}(0.6015-0.0364+0.0080)}=23.97\\mathrm{psi}>13.15\\mathrm{psi}\\text{O.K.}\\end{aligned}",
