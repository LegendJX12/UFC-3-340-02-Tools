        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\boldsymbol{W}&=\\sum r_{u}\\boldsymbol{A}\\boldsymbol{\\varDelta}\\\\\\boldsymbol{W}&=\\sum_{i=1}^{VI}\\boldsymbol{W}_{i}=\\frac{r_{u}\\boldsymbol{\\varDelta}}{3}(243200-320\\boldsymbol{X})\\end{aligned}",
            "block_bbox": [
