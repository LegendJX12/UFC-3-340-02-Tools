        },
        {
            "block_label": "text",
            "block_content": "Calculate total internal work for the assumed deflection of Δ. Use one quarter of the roof slab due to symmetry in both directions. See Figure 4A$\\dot{6}_{\\textrm{(+)}}$ for angles of rotation.\n",
            "block_bbox": [
                273,
                1152,
