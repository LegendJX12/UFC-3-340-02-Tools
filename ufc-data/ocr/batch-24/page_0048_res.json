                1230
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\varTheta_{1H}&=\\varTheta_{1V}=\\frac{\\varLambda}{X}\\\\\\varTheta_{2H}&=\\varTheta_{2V}=\\frac{\\varLambda}{H-C/2-X}=\\frac{\\varLambda}{240-40/2-X}=\\frac{\\varLambda}{220-X}\\\\\\varTheta_{3H}&=\\varTheta_{3V}=\\frac{\\varLambda}{(H-C)/2}=\\frac{\\varLambda}{(240-40)/2}=\\frac{\\varLambda}{100}\\end{aligned}",
            "block_bbox": [
                275,
                1254,
