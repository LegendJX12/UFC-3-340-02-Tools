        {
            "block_label": "text",
            "block_content": "Calculate total external work for an assumed deflection of Δ. Use one quarter of the roof slab due to symmetry in both directions. See Figure 4A6 (+) for yield lines and sectors.\n",
            "block_bbox": [
                273,
                267,
                1046,
                345
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Equivalent square column capital, CXc.",
            "block_bbox": [
                275,
                365,
                703,
                389
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\boldsymbol{C}&=\\left[\\frac{\\pi\\boldsymbol{D}^2}{4}\\right]^{1/2}=\\left[\\frac{\\pi\\left(45\\right)^2}{4}\\right]^{1/2}=39.9in say40\\times40in\\\\\\boldsymbol{W}_1&=\\boldsymbol{W}_{tV}=r_u\\left[\\left(\\frac{3L}{2}-\\boldsymbol{X}\\right)\\left(\\boldsymbol{X}\\right)\\frac{\\boldsymbol{A}}{2}+\\left(\\frac{\\boldsymbol{X}^2}{2}\\right)\\frac{\\boldsymbol{A}}{3}\\right]\\\\&=r_u\\left[\\left(\\frac{3\\times240}{2}-\\boldsymbol{X}\\right)\\left(\\boldsymbol{X}\\right)\\frac{\\boldsymbol{A}}{2}+\\left(\\frac{\\boldsymbol{X}^2}{2}\\right)\\frac{\\boldsymbol{A}}{3}\\right]\\\\\\boldsymbol{W}_{it}&=\\boldsymbol{W}_v=r_u\\left[\\boldsymbol{C}\\left[\\boldsymbol{H}-\\boldsymbol{C}/2-\\boldsymbol{X}\\right]\\frac{\\boldsymbol{A}}{2}+\\frac{1}{2}\\left[\\frac{3L}{2}-\\boldsymbol{X}-\\boldsymbol{C}\\right]\\boldsymbol{H}-\\frac{\\boldsymbol{C}}{2}-\\boldsymbol{X}\\left[\\frac{2\\boldsymbol{A}}{3}\\right]\\right]\\\\&=r_u\\left[40\\left(240-\\frac{40}{2}-\\boldsymbol{X}\\right)\\frac{\\boldsymbol{A}}{2}+\\frac{1}{2}\\left(\\frac{3\\times240}{2}-\\boldsymbol{X}-40\\right)\\left(240-\\frac{40}{2}-\\boldsymbol{X}\\right)\\left(\\frac{2\\boldsymbol{A}}{3}\\right)\\right]\\\\\\boldsymbol{W}_{it}&=\\boldsymbol{W}_{it}=r_u\\left[\\frac{\\boldsymbol{C}}{2}\\big(\\boldsymbol{H}-\\boldsymbol{C}\\big)\\frac{\\boldsymbol{A}}{2}+\\frac{1}{2}\\left(\\frac{3L}{2}-\\boldsymbol{X}-\\boldsymbol{C}\\right)\\left(\\frac{\\boldsymbol{H}-\\boldsymbol{C}}{2}\\right)\\left(\\frac{2\\boldsymbol{A}}{3}\\right)\\right]\\\\&=r_u\\left[\\frac{40}{2}\\big(240-40\\big)\\frac{\\boldsymbol{A}}{2}+\\frac{1}{2}\\left[\\frac{(3)\\big(240)}{2}-\\boldsymbol{X}-40\\right]\\left(\\frac{240-40}{2}\\right)\\left(\\frac{2\\boldsymbol{A}}{3}\\right)\\right]\\end{aligned}",
            "block_bbox": [
                279,
                410,
                1028,
                931
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "From Equation 4-74.",
            "block_bbox": [
                275,
