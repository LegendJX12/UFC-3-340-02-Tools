        },
        {
            "block_label": "text",
            "block_content": "Step 19.Calculate actual moment capacity at $m^{+}{}_{5}$ ,assume No.4 reinforcing bars 12 in o.c.\n",
            "block_bbox": [
                134,
                484,
                1028,
                534
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&d_{e}\\ln H\\operatorname{direction}=d_{H}=15-2-0.75-2\\times0.75^{*}+2\\times\\frac{0.5}{2}=11.25\\ln\\\\ &d_{e}\\ln L\\operatorname{direction}=d_{V}=15-2-0.75-2\\times0.75^{*}-2\\times\\frac{0.5}{2}=10.25\\ln\\\\ \\end{aligned}",
            "block_bbox": [
                346,
                558,
                1020,
                675
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "*Assumed No.6 reinforcing in Step 2.",
            "block_bbox": [
                276,
                696,
                669,
                719
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "M_{u}=\\frac{A_{s}f_{d s}d_{c}}{b}",
            "block_bbox": [
                348,
                742,
                484,
                795
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&M_{14}^{+}=\\frac{0.2\\times85,860\\times11.25}{12}=16099in-lb/in>14333O.K.\\\\&M_{5}^{+}=\\frac{0.2\\times85,860\\times10.25}{12}=14668in-lb/in>14333O.K.\\\\ \\end{aligned}",
            "block_bbox": [
                347,
                817,
                941,
                934
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "p=\\frac{A_{s}}{b d_{e}}",
