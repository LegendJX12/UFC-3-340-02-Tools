            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "Step 20.Calculate the provided unit resistance of the flat slab.",
            "block_bbox": [
                134,
                1177,
                827,
                1201
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&r_{u}(\\text{provided})=r_{e}(\\text{required})\\times\\frac{m(\\text{unit moment provided})}{m(\\text{unit moment required})}\\\\&\\left(r_{u}\\right)_{m14}=12.25\\times\\frac{16099}{14333}=13.76\\text{psi}\\\\&\\left(r_{u}\\right)_{m5}=12.25\\times\\frac{14668}{14333}=12.54\\text{psi}\\\\&r_{u}=\\frac{\\left(r_{u}\\right)_{m14}+\\left(r_{u}\\right)_{m5}}{2}=\\frac{13.76+12.54}{2}=13.15\\text{psi}>12.25\\text{O.K.}\\\\ \\end{aligned}",
