        },
        {
            "block_label": "formula",
            "block_content": "m_{5}^{+}=\\frac{0.256\\times13,437,115}{240}=14333\\mathrm{in}-\\mathrm{lbs}/\\mathrm{in}",
            "block_bbox": [
