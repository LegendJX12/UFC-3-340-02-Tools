            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "formula",
            "block_content": "\\mathrm{Minimum}\\mathrm{unit moment}=\\mathrm{m}_5^+=\\frac{0.256M_{\\mathrm{OH}}}{240}",
            "block_bbox": [
                347,
                312,
                765,
                366
