    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 Septmeber 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "fasteners shall be used per valley. Fasteners shall not be located at panel crowns.\n",
            "block_bbox": [
                414,
                267,
                1008,
                315
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "7.4.2 Fasteners which do not provide positive locking such as selftapping screws or self-drilling and self-tapping screws shall not be used at side laps of panels and for fastening accessories to panels. Fasteners for side laps shall be located in each valley of the overlap and positioned a maximum of 8 inches on center.\n",
            "block_bbox": [
                346,
                337,
                1045,
                493
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "7.4.3 Screws shall be not less than No. 14 diameter if self-tapping type and not less than No. 12 diameter if self-drilling and self-tapping type.\n",
            "block_bbox": [
                346,
                515,
                1040,
                593
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "7.4.4 Automatic end-welded studs shall be shouldered type with a shank diameter of not less than 3/16 inch with cap and nut for holding the covering against the shoulder.",
            "block_bbox": [
                346,
                614,
                1040,
                691
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "7.4.5 Fasteners for use with power actuated tools shall have a shank diameter of not less than 1/2 inch. Fasteners for securing wall panels shall have threaded studs for attaching approved nuts or caps.\n",
            "block_bbox": [
                346,
                711,
                1037,
                816
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "7.4.6 Blind rivets shall be stainless steel with 1/8 inch nominal diameter shank. Rivets shall be threaded stem type if used for other than fastening of trim. Rivets with hollow stems shall have closed ends.\n",
            "block_bbox": [
                346,
                836,
                1026,
                939
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "7.4.7 Bolts shall not be less than 1/4 inch diameter, shoulders or plain shank as required with proper nuts.",
            "block_bbox": [
                345,
                961,
                1025,
                1012
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "7.4.8 Provide oversize washers with an outside diameter of 1 inch at each fastener or a 22 gauge thick metal strip along each valley of the panel to negate pull-out of the panel around the fasteners.\n",
            "block_bbox": [
                346,
                1033,
                1041,
                1134
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "number",
            "block_content": "6-68",
            "block_bbox": [
                576,
                1485,
                622,
                1505
            ],
            "block_id": 9,
            "block_order": null
        }
    ],
