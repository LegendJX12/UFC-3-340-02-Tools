        {
            "block_label": "aside_text",
            "block_content": "Step 6.",
            "block_bbox": [
                136,
                266,
                212,
                290
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Using the acceleration impulse extrapolation method from Chapter 3 of this manual determine maximum horizontal acceleration, displacement and velocity of the structure due to load curve (P) from Step 2c. Resisting force R is the friction force produced due to the downward load curve F from Step 4b after an initial lateral translation of 1/4 inch. Use two ms time intervals for extrapolation. The following are the equations used in the extrapolation shown in Table 2A-3 (+)\n",
            "block_bbox": [
                273,
                267,
                1040,
                451
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&P_{n}-R_{n}=m a_{n}\\\\&R_{n}=\\mu F_{n}\\\\&X_{n+1}=2X_{u}-X_{n-1}+a_{n}(\\delta t)^{2}\\\\&V_{n}=V_{n-1}+a_{n}(\\delta t)\\\\ \\end{aligned}",
            "block_bbox": [
                274,
                471,
                545,
                635
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "where ",
            "block_bbox": [
                275,
                656,
                344,
                674
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Pn = Load at time of step n (Stp 2c)",
            "block_bbox": [
                344,
                699,
                729,
                721
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Rn = Resisting Friction Force at time step n ",
            "block_bbox": [
                344,
                743,
                796,
                765
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "m = Mass (Step 3b)",
            "block_bbox": [
                344,
                787,
                556,
                809
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "an = Acceleration at time step n ",
            "block_bbox": [
                344,
                832,
                675,
                854
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": " = Friction coefficient (Step 5)",
            "block_bbox": [
                344,
                878,
                670,
                902
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Fn = Downward force at time step n (Step 4b)",
            "block_bbox": [
                344,
                921,
                819,
                945
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "X = Deflection at time step n ",
            "block_bbox": [
                344,
                966,
                654,
                989
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "formula",
            "block_content": "V_{n}=\\operatorname{V e l o c i t y}\\operatorname{a t}\\operatorname{t i m e}\\operatorname{s t e p}n ",
            "block_bbox": [
                347,
                1010,
                632,
                1034
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "The maximum motions from Table 2A-3 (+) are:",
