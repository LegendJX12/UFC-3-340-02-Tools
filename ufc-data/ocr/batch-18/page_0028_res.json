        {
            "block_label": "text",
            "block_content": "Step 6:",
            "block_bbox": [
                135,
                266,
                213,
                289
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "a.Find $F_{E}$ using Equation 3-42:",
            "block_bbox": [
                274,
                310,
                656,
                334
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}F_{E}&=\\int_{0}^{L}p(x)\\phi(x)dx=2\\int_{0}^{60}(2,000\\mathrm{lb}/\\mathrm{in})(2x/L)dx\\\\&=4,000\\mathrm{lb}/\\mathrm{in}\\left[x^{2}/L\\right]_{0}^{60}\\\\&=120.000\\mathrm{lb}\\end{aligned}",
            "block_bbox": [
                347,
                355,
                815,
                476
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "b.From Equation 3-41:",
            "block_bbox": [
                275,
                502,
                565,
                525
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "K_{L}=\\frac{F_{E}}{F}=\\frac{120,000\\mathrm{~lb}}{(2,000\\mathrm{~lb}/\\mathrm{in})(120\\mathrm{~in})}",
            "block_bbox": [
                347,
                549,
                663,
                610
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "K_{L}=0.5\\ in the plastic range ",
            "block_bbox": [
                345,
                632,
                637,
                657
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "Step 7:",
            "block_bbox": [
                135,
                676,
                213,
                700
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "a.Use Equation 3-48 to find the equivalent mass:",
            "block_bbox": [
                274,
                721,
                833,
                745
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}M_{E}=\\int_{0}^{L}m(x)\\varphi^{2}(x)dx=2\\int_{0}^{60}(0.0055)\\left(4x^{2}/L^{2}\\right)dx\\\\=0.044\\left[\\frac{x^{3}}{3L^{2}}\\right]_{0}^{60}\\\\=0.22\\left|b-s^{2}\\right|\\left|n\\right|\\end{aligned}",
            "block_bbox": [
                347,
                767,
                834,
                932
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "b.As defined by Equation 3-47",
            "block_bbox": [
                275,
                958,
                645,
                981
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "formula",
            "block_content": "K_{M}=\\frac{M_{E}}{M}=\\frac{0.22\\mathrm{~lb}-s^{2}/\\mathrm{in}}{(0.0055\\mathrm{~lb}-s^{2}/\\mathrm{in}^{2})(120\\mathrm{~in})}",
            "block_bbox": [
                347,
                1005,
                753,
                1071
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "formula",
            "block_content": "K_{M}=0.33\\ in the plastic range ",
            "block_bbox": [
                346,
