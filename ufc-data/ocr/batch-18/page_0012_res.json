    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{M_{V P}}{M_{V N2}}=\\frac{20,000}{20,000}=1.0",
            "block_bbox": [
                278,
                266,
                493,
                323
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Read yield line location:",
            "block_bbox": [
                276,
                349,
                526,
                371
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "$X_{1}/L$ . exceeds the maximum possible value of 0.5 therefore, assumed yield line pattern is wrong. Assume alternate yield line pattern as shown in Figure $3A-2\\left(+\\right)$ L:",
            "block_bbox": [
                274,
                393,
                1042,
                472
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "From Figure 3-16 (+) calculate the following parameters:",
            "block_bbox": [
                275,
                492,
                862,
                516
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{L}{H}=\\frac{\\left(M_{vN3}+M_{vP}\\right)^{1/2}}{\\left(M_{HN2}+M_{HP}\\right)^{1/2}+\\left(M_{HN1}+M_{HP}\\right)^{1/2}}\\quad 与 \\quad\\frac{240}{168}\\left[\\frac{\\left(20,000+20,000\\right)^{1/2}}{\\left(20,000+20,000\\right)^{1/2}+\\left(20,000+20,000\\right)^{1/2}}\\right]=0.71",
            "block_bbox": [
                277,
                539,
                895,
                686
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "and ",
            "block_bbox": [
                276,
                712,
                320,
                732
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\frac{X}{L}=\\frac{\\left[\\left(M_{H N1}+M_{H P}\\right)/\\left(M_{H N2}+M_{H P}\\right)\\right]^{1/2}}{1+\\left[\\left(M_{H N1}+M_{H P}\\right)/\\left(M_{H N2}+M_{H P}\\right)\\right]^{1/2}}\\\\=\\frac{\\left[40,000/40,000\\right]^{1/2}}{1+\\left[40,000/40,000\\right]^{1/2}}=1/2\\end{aligned}",
            "block_bbox": [
                278,
                756,
                670,
                902
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "From Figure 3-16 (+) read of yield line location:",
            "block_bbox": [
                275,
                924,
                765,
                948
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&y/H=0.82;~y=0.8(168)=137.6\\quad in\\\\&X/L=0.50;~X=0.5(240)=120.0\\quad in\\\\ \\end{aligned}",
            "block_bbox": [
                274,
                967,
                646,
                1036
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "Step 5.From Table 3-2 (+):",
            "block_bbox": [
                134,
                1056,
                483,
                1081
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "NOTE:",
            "block_bbox": [
                135,
                1100,
                210,
                1123
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "Both equations given in the table for each edge condition and yield line location will provide identical values of $r_{u}$ \n",
            "block_bbox": [
                273,
                1101,
                1009,
                1153
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}=\\frac{5(M_{vN}+M_{VP})}{y^{2}}=\\frac{5(20,000+20,000)}{137.6^{2}}=(0.00055)20,000=10.5\\mathrm{~ps}i ",
            "block_bbox": [
                275,
                1172,
                975,
                1233
            ],
            "block_id": 13,
            "block_order": 13
        },
