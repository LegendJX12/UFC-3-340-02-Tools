    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "paragraph_title",
            "block_content": "4-55",
            "block_bbox": [
                136,
                267,
                186,
                287
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "paragraph_title",
            "block_content": "PREDICTION OF CONCRETE SPALLING.",
            "block_bbox": [
                276,
                266,
                729,
                287
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "As previously explained, direct spalling is due to a compression wave traveling through a concrete element, reaching the back face and being reflected as a tension wave.Spalling occurs when the tension is greater than the tensile strength of the concrete.",
            "block_bbox": [
                133,
                311,
                1035,
                386
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Many spall tests have been conducted on the configuration shown in Figure 4-65 (+),where a cylindrical charge, cased or bare, is oriented with its longitudinal axis parallel to the wall. Tested variations to this configuration include non-cylindrical charge shapes,charges off the ground, and charges in contact with the slab. Test data for all of these cases have been compiled and analyzed and are plotted in Figure 4-65a (+). The test data in this figure are reported in terms of the observed severity of spall, i.e., as either no spall, spall (no breach), or breach. Threshold spall and breach curves are plotted as approximate upper bounds to the spall and breach data points, respectively and may be used in design. The spall threshold curve is given by Equation 4-178:\\2\\",
            "block_bbox": [
                133,
                408,
                1044,
                647
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "\\2\\",
            "block_bbox": [
                134,
                667,
                167,
                687
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{h}{R}=\\frac{1}{a+b\\Psi^{2.5}+c\\Psi^{0.5}}",
            "block_bbox": [
                136,
                731,
                364,
                792
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "where:",
            "block_bbox": [
                134,
                847,
                209,
                866
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{array}{r l}&{h=c o n c r e t e t h i c k n e s s(\\hat{\\psi})}\\\\ &{R=R a n g e f r o m s l a b f a c e t o c h a r g e c e n t e r o f g r a v i t y(\\hat{\\psi})}\\\\ &{a=-0.02511}\\\\ &{b=0.01004}\\\\ &{c=0.13613}\\\\ &{\\Psi=s p a l l p a r a m e t e r(E q u a t i o n s4–180a a n d4–180b)}\\end{array}",
            "block_bbox": [
