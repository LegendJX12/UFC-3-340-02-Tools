    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2, 1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "The spiral reinforcement must conform to the following:",
            "block_bbox": [
                135,
                267,
                709,
                289
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "1.Spiral column reinforcement shall consist of evenly spaced continuous spirals composed of continuous #3 bars or larger. Circular bars are not permitted.\n",
            "block_bbox": [
                206,
                311,
                1008,
                386
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "2.The clear spacing between spiral shall not exceed 3 inches nor be less than 1 inch.\n",
            "block_bbox": [
                204,
                408,
                1009,
                457
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "3.Anchorage of spiral reinforcement shall be provided by 1-½ extra turns of spiral bar at each end.\n",
            "block_bbox": [
                204,
                479,
                1034,
                529
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "4.Splices in spiral reinforcement shall be lap splices equal to 1-½ turns of spiral bar.\n",
            "block_bbox": [
                204,
                550,
                1015,
                600
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "5.Spirals shall extend from top of footing or slab to level of lowest horizontal reinforcement in members supported above.\n",
            "block_bbox": [
                204,
                622,
                1039,
                672
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "6.In columns with capitals, spirals shall extend to a level at which the diameter or width of capital is two times that of the column.",
            "block_bbox": [
                204,
                693,
                969,
                742
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "number",
            "block_content": "4-191",
            "block_bbox": [
                568,
                1485,
                627,
                1504
            ],
            "block_id": 8,
            "block_order": null
        }
    ],
