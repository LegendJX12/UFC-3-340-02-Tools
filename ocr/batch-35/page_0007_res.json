        },
        {
            "block_label": "text",
            "block_content": "The reinforcing steel area does not exceed the maximum requirement – OK \n",
            "block_bbox": [
                414,
                267,
                1008,
                315
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "C.Check that the maximum and minimum reinforcement spacing requirements are met (Section 6-8.3)\n",
            "block_bbox": [
                274,
                338,
                991,
                387
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "The spacing of the vertical rebar is 16 inches. This is not greater than the maximum spacing for walls not fully grouted of 3 times the nominal wall thickness (i.e. 24 inches), and it is not less than the minimum spacing of one bar per cell (i.e.8 inches) - OK ",
            "block_bbox": [
                343,
                408,
                1039,
                512
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Step 5.",
            "block_bbox": [
                136,
                532,
                212,
                558
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Calculate ultimate resistance (Table 3-1 (+))",
            "block_bbox": [
                275,
                533,
                737,
                557
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}=\\frac{8M_{p}}{L^{2}}=\\frac{8(3450)}{150^{2}}",
            "block_bbox": [
                347,
                578,
                484,
                736
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "Step 6.",
            "block_bbox": [
                136,
                760,
                212,
                785
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Find the average moment of inertia of the wall.",
            "block_bbox": [
                275,
                760,
                760,
                783
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "a.Calculate the moment of inertia of net section (Equation 6-1 and Table 6-1 (+))\n",
            "block_bbox": [
                273,
                804,
                1010,
                853
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&I_{n}=I_{m}+\\frac{(t-2t_{s})^{3}}{12}\\frac{V}{100}\\psi_{m}\\\\&\\quad=27+\\frac{(7.63-2(1.25))^{3}}{12}\\frac{50}{100}(0.81)^{3}\\\\&\\quad=31.6in^{4}/in\\\\ \\end{aligned}",
            "block_bbox": [
                347,
                878,
                728,
                1036
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "b.Calculate the moment of inertia of cracked section (Equation 6-11)",
            "block_bbox": [
                286,
                1057,
                1035,
                1081
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&J_{c}=0.005d^{3}\\\\ &\\quad=0.005(3.81)^{3}\\\\ &\\quad=0.27in^{4}/in\\\\ \\end{aligned}",
            "block_bbox": [
                347,
                1102,
                523,
                1204
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "C.Calculate the average moment of inertia (Equation 6-10)",
            "block_bbox": [
                286,
                1225,
                932,
                1249
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}I_{a}=&\\frac{I_{n}+I_{c}}{2}\\\\ =&\\frac{31.6+0.27}{2}\\\\ =&15.9in^{4}/in\\end{aligned}",
            "block_bbox": [
