    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "additional tests may be conducted; each of the two additional tests must demonstrate the development of a minimum 3% strain in the rebar. Rebar may be grouped in one of two groups of rebar sizes (no. 4, 5, 6,7 and no. 8, 9, 10,11). Success of a mechanical device on a rebar size within its group shall be considered applicable to all rebar sizes in that group.\n",
            "block_bbox": [
                133,
                267,
                1041,
                397
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Mechanical splices shall be located in regions of low stress where the area of reinforcement provided is a least twice that required. In addition, mechanical splices of adjacent parallel reinforcing bars shall be staggered by at least their splice length,calculated in accordance with ACI 318./1/\n",
            "block_bbox": [
                133,
                417,
                1037,
                520
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "4-21.9Welding of Reinforcement.",
            "block_bbox": [
                134,
                543,
                574,
                564
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Welding of reinforcement is to be avoided in blast resistant structures since it results in a reduction of the ultimate strength and ductility of the reinforcing steel. In those cases where welding is absolutely essential, it may be necessary to obtain special reinforcement manufactured with controlled chemical properties, such as ASTM A 706.Tests showing the adequacy of the combination of weld and reinforcing steel under dynamic conditions must be performed to demonstrate that this welding does not reduce the ultimate strength and ductility of the reinforcing steel. In lieu of these tests,welding in accordance with the provisions of the latest ACI 318 Building Code is permitted if the stress in the reinforcement is maintained at a level less than 90 percent of the yield stress.\n",
            "block_bbox": [
                133,
                587,
                1035,
                851
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "4-21.10Bundled Reinforcing Bars.",
            "block_bbox": [
                134,
                873,
                573,
                894
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "The use of bundled bars may be required for unusual conditions. However, their use is not desirable and should be avoided where possible. A 3 bar bundle should be the maximum bundle employed. The development length and lap splice length of individual bars within a bundle shall be determined in accordance with the latest ACI 318 Building Code. Splices of the individual bars within a bundle should be staggered. That is, only one bar of the bundle should be spliced at a given location.\n",
            "block_bbox": [
                133,
                917,
                1041,
                1074
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "number",
            "block_content": "4-48",
            "block_bbox": [
                575,
                1485,
                622,
                1504
            ],
            "block_id": 7,
            "block_order": null
        }
    ],
