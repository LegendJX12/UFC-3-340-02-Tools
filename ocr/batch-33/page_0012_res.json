                985,
                404
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "paragraph_title",
            "block_content": "6-31.3Certification for Rebound.",
            "block_bbox": [
                134,
                425,
                565,
                446
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Acceptance testing shall be performed for rebound unless analysis demonstrates that the frame meets rebound criteria. All frames with mullions must be tested. Testing is performed with the load applied to the inboard surface of the window assembly. The equivalent static rebound load,$r^{-}$ , is substituted for the design load,,$r_{u}$ ,",
            "block_bbox": [
                133,
                469,
                1021,
                573
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "paragraph_title",
            "block_content": "6-32INSTALLATION INSPECTION.",
