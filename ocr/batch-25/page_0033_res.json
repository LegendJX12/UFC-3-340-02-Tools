    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Step 4.",
            "block_bbox": [
                136,
                267,
                211,
                290
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Check reinforcement requirements:",
            "block_bbox": [
                275,
                267,
                645,
                289
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "a.Calculate d negative (support) and positive (mid-span) for checking bending reinforcement ratios.\n",
            "block_bbox": [
                274,
                310,
                1042,
                360
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&d=h-d^{\\prime}(cover)-\\phi^{\\prime}(lie)-\\frac{\\phi}{2}(Bending Bar)\\\\ &d_{N}=30-2-0.5-0.75/2=27.125in\\\\ &d_{p}=30-1.5-0.5-0.75/2=27.625in\\\\ \\end{aligned}",
            "block_bbox": [
                346,
                386,
                796,
                506
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "b.Calculate reinforcement ratio:",
            "block_bbox": [
                275,
                532,
                657,
                554
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "From Equation 4-131,",
            "block_bbox": [
                343,
                576,
                576,
                599
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&p=A_{s}/bd\\\\&p_{N}=2.2/(18\\times27.125)=0.0045\\\\&p_{p}=2.2/(18\\times27.615)=0.0044\\\\ \\end{aligned}",
            "block_bbox": [
                343,
                619,
                676,
                735
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "C.Maximum reinforcement:",
            "block_bbox": [
                275,
                754,
                608,
                775
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Maximum reinforcing ratio $p_{m a x}=0.75~x~p_{b}$ ",
            "block_bbox": [
                344,
                798,
                787,
                822
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "From Equation 4-132;",
            "block_bbox": [
                344,
                842,
                577,
                865
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "formula",
            "block_content": "p_{b}=\\left[\\frac{0.85K_{1}f_{dc}^{\\prime}}{f_{dy}}\\right]\\cdot\\left[\\frac{87.000}{87.000+f_{dy}}\\right]",
            "block_bbox": [
                386,
                886,
                726,
                961
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "where:",
            "block_bbox": [
                349,
                972,
                430,
                990
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}K_{1}&=0.85-\\frac{0.05(f_{dc}^{\\prime}-4.000)}{1.000}=0.812\\\\p_{b}&=\\frac{0.85\\times0.812\\times4760}{77.220}\\left(\\frac{87.000}{87.000+77.220}\\right)=0.0225\\\\p_{max}&=0.75\\times0.0225=0.0169>p_{N}=0.0045\\mathrm{~and}\\\\p_{p}&=0.0044\\mathrm{~O.K.}\\end{aligned}",
            "block_bbox": [
                370,
                1002,
                934,
                1204
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "d.Check minimum reinforcing ratio against the larger value from equations 4-138 and 4-138a:",
            "block_bbox": [
                274,
                1229,
                986,
                1279
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "formula",
            "block_content": "p_{min}=\\frac{200}{f_y}=\\frac{200}{66,000}=0.0030",
            "block_bbox": [
                347,
                1300,
                659,
                1359
            ],
            "block_id": 15,
            "block_order": 15
        },
        {
            "block_label": "formula",
            "block_content": "p_{min}=\\frac{3\\sqrt{f_c^{\\prime}}}{f_v}=\\frac{3\\sqrt{4,000}}{66,000}=0.0029",
            "block_bbox": [
                348,
                1384,
                690,
                1454
            ],
            "block_id": 16,
            "block_order": 16
        },
        {
            "block_label": "formula_number",
            "block_content": "(Equation 4-138)",
            "block_bbox": [
                874,
                1313,
                1049,
                1339
            ],
            "block_id": 17,
            "block_order": null
        },
        {
            "block_label": "formula_number",
