                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "b.Maximum spacing:",
            "block_bbox": [
                274,
                267,
                544,
                290
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}s_{max}&=\\frac{h_t+b_t}{4}\\\\&=\\frac{26+14.5}{4}\\\\&=10.125in>7in\\quad Q.K.\\end{aligned}",
            "block_bbox": [
                347,
                313,
                667,
                460
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Step 9.Required area of longitudinal steel is the greater of the two values from Equations 4-151a or 4-151b.\n",
            "block_bbox": [
                134,
                487,
                1011,
                537
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}A_{1}&=2A_{t}\\times\\frac{b_{t}+h_{t}}{s}\\\\&=2\\times0.06\\times\\frac{14.5+26.0}{12}=0.40in^{2}\\end{aligned}",
            "block_bbox": [
                378,
                561,
                758,
                678
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "\\boldsymbol{A}_{1}=\\left[\\frac{400\\times\\boldsymbol{b}\\times\\boldsymbol{s}}{f_{d y}}\\frac{\\boldsymbol{v}_{t u}}{\\boldsymbol{v}_{t u}+\\boldsymbol{v}_{u}}-2\\boldsymbol{A}_{t}\\right]\\times\\frac{\\boldsymbol{b}_{t}+\\boldsymbol{h}_{t}}{\\boldsymbol{s}}",
            "block_bbox": [
                379,
                719,
                799,
                794
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "where:",
            "block_bbox": [
                348,
                804,
                430,
                824
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{2A_{t}}{f_{d_{y}}}=\\frac{50bs}{f_{d_{y}}}=\\frac{50\\times18\\times12}{66.000}=0.16\\ln^{2}/\\mathrm{ft}=2A_{t}\\\\A_{1}=\\left[\\frac{400\\times18\\times12}{66.000}\\frac{82.5}{82.5+235.2}-0.12\\right]\\times\\frac{14.5+26.00}{12}\\\\=0.74\\ln^{2}",
            "block_bbox": [
                349,
                838,
                929,
                1075
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "Step 10.Distribute $A_{I},A_{s},$ ,and $A_{s}\\bar{}$ as follows (see Figure 4A-16 (+)):",
            "block_bbox": [
                133,
                1102,
                887,
                1127
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "Distribute $A_{l}$ equally between four corners of the beam and one on each face of depth, a total of six locations to satisfy maximum spacing of 12inches.\n",
            "block_bbox": [
                272,
                1147,
                1018,
                1222
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "A/6=0.74/6=0.12\\mathrm{i n}^{2}",
            "block_bbox": [
                344,
                1241,
                601,
                1266
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Vertical Face:",
            "block_bbox": [
                274,
                1290,
                423,
                1310
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}&\\mathrm{One}\\ (1)\\ \\mathrm{No.4\\ bar}\\\\ &=0.20\\ \\mathrm{in}^2>0.12\\ \\mathrm{O.K.}\\\\ \\end{aligned}",
            "block_bbox": [
                343,
                1333,
                580,
                1399
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
