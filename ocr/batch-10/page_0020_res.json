            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "Step 1.Establish design parameters:",
            "block_bbox": [
                134,
                453,
                582,
                477
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "a. fragment material.",
