    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "UFC 3-340-025 December 2008Change 2,1 September 2014",
            "block_bbox": [
                731,
                147,
                1050,
                233
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Step 4.For distribution of moments across negative and assumed positive lines,see Figure 3A-2(a) (+).\n",
            "block_bbox": [
                134,
                266,
                1024,
                317
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Step 5.The ultimate unit resistance of each sector is obtained by taking the summation of the moments about its axis of rotation (supports) so that \n$\\Sigma M_{N}+\\Sigma M_{P}=R c=r_{u}A c$ \n",
            "block_bbox": [
                136,
                336,
                1004,
                416
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "a.Sector I (Figure 3A-2 (+))",
            "block_bbox": [
                275,
                437,
                619,
                462
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\Sigma M_{VN}+\\Sigma M_{VP}&=120(20,000)+2(2/3)(20,000)(60)+\\\\&\\quad120(20,000)+2(2/3)(20,000)(60)\\\\&=8.0\\times10^6in-lbs.\\end{aligned}",
            "block_bbox": [
                343,
                481,
                888,
                596
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}A\\boldsymbol{c}=r_{u}\\left[\\frac{240(y)}{2}\\right]\\left[\\frac{y}{3}\\right]=40r_{u}y^{2}",
            "block_bbox": [
                347,
                616,
                671,
                679
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "therefore,",
            "block_bbox": [
                344,
                700,
                450,
                721
            ],
            "block_id": 6,
            "block_order": 6
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}=400(20,000)/40y^{2}=0.2\\times10^{6}/y^{2}",
            "block_bbox": [
                344,
                740,
                713,
                768
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "b.Sector Il (Figure 3A-2 (+))",
            "block_bbox": [
                275,
                788,
                632,
                813
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}{\\Sigma M_{H N}+\\Sigma M_{H P}=}&{{}(168{-}y/2)(20{,}000)+(2/3)(20{,}000)(y/2)+}\\\\ {}&{{}(20{,}000)(168{-}y/2)+(2/3)(20{,}000)(y/2)}\\\\ {=}&{{}336(20{,}000)-(y/3)(20{,}000)}\\end{aligned}",
            "block_bbox": [
                344,
                833,
                940,
                947
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}r_{u}A c=&r_{u}\\left[\\frac{120\\left(168+168-y\\right)}{2}\\right]\\left[\\frac{120\\left(168+2\\left(168-y\\right)\\right)}{3}\\right]/\\left(168+168-y\\right)\\\\=&4.800r_{u}\\left(252-y\\right)\\end{aligned}",
            "block_bbox": [
                277,
                967,
                985,
                1067
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "therefore,",
            "block_bbox": [
                344,
                1093,
                449,
                1114
            ],
            "block_id": 11,
            "block_order": 11
        },
        {
            "block_label": "formula",
            "block_content": "r_{u}=\\frac{336(20,000)-\\frac{y}{3}(20,000)}{4800(252-y)}",
            "block_bbox": [
                347,
                1145,
                650,
                1229
            ],
            "block_id": 12,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "Step 6.Equate the ultimate unit resistance of the sectors.",
            "block_bbox": [
                134,
                1252,
                790,
                1276
            ],
            "block_id": 13,
            "block_order": 13
        },
        {
            "block_label": "formula",
            "block_content": "\\frac{10(20,000)}{y^{2}}=\\frac{336(20,000)-\\frac{y}{3}(20,000)}{4800(252-y)}",
            "block_bbox": [
                278,
                1306,
                676,
                1390
            ],
            "block_id": 14,
            "block_order": 14
        },
        {
            "block_label": "number",
