        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}\\phi=&\\frac{\\delta(\\boldsymbol{x})}{\\delta_{\\max}}=\\frac{p(\\boldsymbol{x})\\boldsymbol{x}}{24EI}\\left(L^{3}-2L\\boldsymbol{x}^{2}+\\boldsymbol{x}^{3}\\right)\\left(\\frac{384EI}{5p(\\boldsymbol{x})L^{4}}\\right)\\\\=&\\frac{16}{5L^{4}}\\left(L^{3}\\boldsymbol{x}-2L\\boldsymbol{x}^{3}+\\boldsymbol{x}^{4}\\right)\\end{aligned}",
            "block_bbox": [
                276,
                269,
                720,
                393
            ],
            "block_id": 1,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "Step 6:a.Using Equation 3-42, determine equivalent force ",
            "block_bbox": [
                134,
                416,
                850,
                440
            ],
            "block_id": 2,
            "block_order": 2
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}F_{E}=\\int_{0}^{L}p(x)\\phi(x)dx=\\int_{0}^{L^{20}}\\left(2,000\\mathrm{lb}/\\mathrm{in}\\right)\\frac{16}{5L^{4}}\\left(L^{3}x-2L x^{3}+x^{4}\\right)dx\\\\=\\frac{6,400}{L^{4}}\\left[\\frac{L^{3}x^{2}}{2}-\\frac{2L x^{4}}{4}+\\frac{x^{5}}{5}\\right]_{0}^{120}=1,280L\\\\=153.600\\mathrm{lb}\\end{aligned}",
            "block_bbox": [
                346,
                463,
                942,
                639
            ],
            "block_id": 3,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "b.From Equation 3-41,find the load factor ",
            "block_bbox": [
                274,
                667,
                762,
                690
            ],
            "block_id": 4,
            "block_order": 4
        },
        {
            "block_label": "formula",
            "block_content": "K_{L}=\\frac{F_{E}}{F}=\\frac{153.600\\mathrm{~lb}}{(2.000\\mathrm{~lb}/\\mathrm{in}\\times120\\mathrm{~in})}",
            "block_bbox": [
                347,
                713,
                666,
                773
            ],
            "block_id": 5,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "$K_{L}=0.64$ in the elastic range ",
