        },
        {
            "block_label": "text",
            "block_content": "Step 7:",
            "block_bbox": [
                135,
                841,
                214,
                866
            ],
            "block_id": 7,
            "block_order": 7
        },
        {
            "block_label": "text",
            "block_content": "a.Find the equivalent mass from Equation 3-48:",
            "block_bbox": [
                275,
                842,
                823,
                865
            ],
            "block_id": 8,
            "block_order": 8
        },
        {
            "block_label": "formula",
            "block_content": "\\begin{aligned}M_{E}=&\\int_{0}^{L}m(x)\\varphi^{2}(x)dx=0.0055\\left(\\frac{256}{25L^{8}}\\left(\\int_{0}^{120}\\left(L^{3}x-2L x^{3}+x^{4}\\right)^{2}dx\\right)\\right)\\\\=&\\frac{1.408}{25L^{8}}\\left(\\int_{0}^{120}\\left(L^{6}x^{2}-4L^{4}x^{4}+2L^{3}x^{5}+4L^{2}x^{6}-4L x^{7}+x^{8}\\right)dx\\right)\\\\=&\\frac{1.408}{25L^{8}}\\left[\\frac{L^{6}x^{3}}{3}-\\frac{4L^{4}x^{5}}{5}+\\frac{2L^{3}x^{6}}{6}+\\frac{4L^{2}x^{7}}{7}-\\frac{4L x^{8}}{8}+\\frac{x^{9}}{9}\\right]_{0}^{120}\\\\=&0.00277L\\\\=&0.3325\\mathsf{lb}-\\mathsf{s}^{2}/\\mathsf{in}\\end{aligned}",
            "block_bbox": [
                347,
                888,
                995,
                1170
            ],
            "block_id": 9,
            "block_order": 9
        },
        {
            "block_label": "text",
            "block_content": "b.From Equation 3-47, calculate the mass factor:",
            "block_bbox": [
                274,
                1195,
                834,
                1218
            ],
            "block_id": 10,
            "block_order": 10
        },
        {
